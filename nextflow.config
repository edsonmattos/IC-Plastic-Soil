// =============================================================================
// nextflow.config - Configuração do Pipeline Microbioma 16S
// =============================================================================

manifest {
    name            = 'microbioma-16s-mpb'
    description     = 'Pipeline 16S rRNA - Microbioma do Solo com Microplásticos'
    version         = '1.0.0'
    nextflowVersion = '>=23.04'
}

// ── Parâmetros padrão ─────────────────────────────────────────────────────────
params {
    threads          = 16
    paired_end       = true
    trunc_f          = 280
    trunc_r          = 235
    trim_left_f      = 0
    trim_left_r      = 0
    max_ee_f         = 2
    max_ee_r         = 2
    classifier       = "${projectDir}/refs/silva-138-99-515-806-nb-classifier.qza"
    metadata         = "${projectDir}/data/manifests/metadata.tsv"
    outdir           = "${projectDir}/results"
    qiime_conda_env  = "/home/edson/miniconda3/envs/qiime2-amplicon-2026.4"
}

// ── Perfis de execução ────────────────────────────────────────────────────────
profiles {

    // Execução local com conda (padrão)
    local {
        conda.enabled       = true
        conda.useMamba      = true
        conda.createTimeout = '60 min'
        process.executor    = 'local'
        process.cpus        = params.threads
        process.memory      = '55 GB'
    }

    // Execução com Docker (requer docker instalado e usuário no grupo docker)
    docker {
        docker.enabled      = true
        docker.runOptions   = '-u $(id -u):$(id -g)'
        process.executor    = 'local'
        process.cpus        = params.threads
        process.memory      = '55 GB'
    }

    // Cluster SLURM (para uso futuro no servidor)
    slurm {
        process.executor    = 'slurm'
        process.cpus        = params.threads
        process.memory      = '55 GB'
        process.time        = '24h'
        conda.enabled       = true
    }
}

// ── Configuração de processos por tipo ───────────────────────────────────────
process {
    withName: 'DOWNLOAD_SRA' {
        cpus   = params.threads
        memory = '8 GB'
    }
    withName: 'DADA2_DENOISE' {
        cpus   = params.threads
        memory = '48 GB'
        time   = '12h'
    }
    withName: 'TAXONOMY' {
        cpus   = params.threads
        memory = '32 GB'
        time   = '6h'
    }
}

// ── Cache e logs ──────────────────────────────────────────────────────────────
workDir        = "${projectDir}/.nextflow_work"
conda.cacheDir = "${HOME}/conda-cache-nextflow"

timeline {
    enabled = true
    file    = "${params.outdir}/reports/timeline.html"
}

report {
    enabled = true
    file    = "${params.outdir}/reports/report.html"
}

dag {
    enabled = true
    file    = "${params.outdir}/reports/dag.svg"
}
